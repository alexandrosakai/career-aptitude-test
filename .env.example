# Obrigatórias (valores aleatórios longos: python3 -c "import secrets; print(secrets.token_hex(32))")
VOC_SECRET=
VOC_SALT=
# Hash da senha do painel: python3 -c "from werkzeug.security import generate_password_hash as g; print(g('SUA_SENHA'))"
VOC_ADMIN_HASH=
# Endereço público do teste (usado nos e-mails de resultado)
VOC_PUBLIC_URL=https://example.com/
# Limites por IP/e-mail (opcionais)
VOC_MAX_IP_HORA=12
VOC_MAX_EMAIL_DIA=3
# E-mail dos resultados (opcional; sem SMTP_HOST o envio fica desativado)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Porta local do site
WEB_PORT=8080
